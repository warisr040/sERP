    {
      "code": "PND1_MONTHLY",
      "name_en": "Monthly salary withholding (PND1)",
      "name_th": "ภาษีเงินเดือนหัก ณ ที่จ่ายรายเดือน (ภ.ง.ด.1)",
      "category": "PIT",
      "rule_type": "formula",
      "is_mandatory": true,
      "description": "Estimate annual tax from the current monthly income, subtract tax already withheld this year, spread over the remaining months.",
      "versions": [
        {
          "version": 1,
          "company_id": null,
          "status": "approved",
          "effective_from": "2017-01-01",
          "effective_to": null,
          "params": {
            "expression": "max(0, round((bracket_tax('PIT_BRACKETS', max(0, ytd_income + monthly_income * months_remaining - capped('PIT_EXPENSE', ytd_income + monthly_income * months_remaining) - rule('PIT_ALLOW_PERSONAL', 'amount') - annual_sso - other_allowances)) - ytd_withheld) / months_remaining, 2))",
            "inputs": [
              "monthly_income",
              "months_remaining",
              "ytd_income",
              "ytd_withheld",
              "annual_sso",
              "other_allowances"
            ],
            "output": "monthly_wht"
          },
          "rounding": "half_up:0.01",
          "legal_reference": "Revenue Code s.50(1); Revenue Dept. Order Por. 161/2560 (calculation method)",
          "source_url": null,
          "notes": "annual_sso and other_allowances come from the employee tax profile / payroll."
        }
      ]
    }
