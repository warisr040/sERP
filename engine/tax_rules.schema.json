{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplyhandleit.example/schemas/tax-rules/1.0.0",
  "title": "simply handle IT ERP — Tax Rule Set export",
  "description": "One file = one jurisdiction (optionally narrowed to one company's overrides). Values are data; rule TYPES are fixed by the engine. Every change is a NEW version with effective dates; approved versions are immutable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "jurisdiction", "exported_at", "base_checksum",
               "updater_instructions", "change_summary", "jurisdiction_info", "rules", "test_cases"],
  "properties": {
    "format":          { "const": "simplyhandleit-erp-tax-rules" },
    "schema_version":  { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "jurisdiction":    { "$ref": "#/$defs/jurisdiction_code" },
    "company_id":      { "type": ["string", "null"], "description": "null = country-level export; set = only this company's overrides (+ the country rules they override, read-only)" },
    "exported_at":     { "type": "string", "format": "date-time" },
    "exported_by":     { "type": ["string", "null"] },
    "base_checksum":   { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Checksum of rules+test_cases at export time. Do NOT change it when editing." },
    "updater_instructions": { "type": "string" },
    "change_summary":  { "type": "string", "description": "Updater fills this: what changed and why, with sources." },
    "supported_rule_types":  { "type": "array", "items": { "$ref": "#/$defs/rule_type" }, "description": "Informational, for the updater." },
    "formula_functions":     { "type": "array", "items": { "type": "string" }, "description": "Informational, for the updater." },

    "jurisdiction_info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "base_currency", "default_rounding"],
      "properties": {
        "code":             { "$ref": "#/$defs/jurisdiction_code" },
        "name":             { "type": "string" },
        "base_currency":    { "type": "string", "pattern": "^[A-Z]{3}$" },
        "default_rounding": { "$ref": "#/$defs/rounding" }
      }
    },

    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },

    "test_cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/test_case" }
    },

    "policies": {
      "type": "object",
      "description": "Only present in company-level exports.",
      "additionalProperties": false,
      "properties": {
        "approval": { "type": "array", "items": { "$ref": "#/$defs/approval_policy" } },
        "retro":    { "type": "array", "items": { "$ref": "#/$defs/retro_policy" } }
      }
    }
  },

  "$defs": {
    "jurisdiction_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "rule_code":         { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,40}$" },
    "date":              { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rate":              { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction: 0.07 = 7%" },
    "money":             { "type": "number", "minimum": 0 },
    "category":          { "enum": ["VAT", "WHT", "PIT", "SSO", "OTHER"] },
    "status":            { "enum": ["draft", "submitted", "approved", "rejected", "retired"] },
    "rule_type":         { "enum": ["flat_rate", "rate_by_category", "rate_with_cap", "fixed_amount", "bracket_table", "threshold", "formula"] },
    "rounding":          { "enum": ["half_up:0.01", "half_up:1", "down:0.01", "down:1", "up:1", "none"] },

    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name_en", "category", "rule_type", "is_mandatory", "versions"],
      "properties": {
        "code":         { "$ref": "#/$defs/rule_code" },
        "name_en":      { "type": "string", "minLength": 1 },
        "name_th":      { "type": ["string", "null"] },
        "category":     { "$ref": "#/$defs/category" },
        "rule_type":    { "$ref": "#/$defs/rule_type" },
        "is_mandatory": { "type": "boolean", "description": "true = an approved version must cover every date (no gaps) from the first version on." },
        "description":  { "type": ["string", "null"] },
        "versions":     { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/version" } }
      },
      "allOf": [
        { "if": { "properties": { "rule_type": { "const": "flat_rate" } } },
          "then": { "properties": { "versions": { "items": { "properties": { "params": { "$ref": "#/$defs/p_flat_rate" } } } } } } },
        { "if": { "properties": { "rule_type": { "const": "rate_by_category" } } },
          "then": { "properties": { "versions": { "items": { "properties": { "params": { "$ref": "#/$defs/p_rate_by_category" } } } } } } },
        { "if": { "properties": { "rule_type": { "const": "rate_with_cap" } } },
          "then": { "properties": { "versions": { "items": { "properties": { "params": { "$ref": "#/$defs/p_rate_with_cap" } } } } } } },
        { "if": { "properties": { "rule_type": { "const": "fixed_amount" } } },
          "then": { "properties": { "versions": { "items": { "properties": { "params": { "$ref": "#/$defs/p_fixed_amount" } } } } } } },
        { "if": { "properties": { "rule_type": { "const": "bracket_table" } } },
          "then": { "properties": { "versions": { "items": { "properties": { "params": { "$ref": "#/$defs/p_bracket_table" } } } } } } },
        { "if": { "properties": { "rule_type": { "const": "threshold" } } },
          "then": { "properties": { "versions": { "items": { "properties": { "params": { "$ref": "#/$defs/p_threshold" } } } } } } },
        { "if": { "properties": { "rule_type": { "const": "formula" } } },
          "then": { "properties": { "versions": { "items": { "properties": { "params": { "$ref": "#/$defs/p_formula" } } } } } } }
      ]
    },

    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "effective_from", "effective_to", "params", "rounding", "legal_reference"],
      "properties": {
        "version":         { "type": "integer", "minimum": 1 },
        "company_id":      { "type": ["string", "null"], "description": "null = country rule; set = company override" },
        "status":          { "$ref": "#/$defs/status" },
        "effective_from":  { "$ref": "#/$defs/date" },
        "effective_to":    { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "params":          { "type": "object" },
        "rounding":        { "$ref": "#/$defs/rounding" },
        "legal_reference": { "type": ["string", "null"] },
        "source_url":      { "type": ["string", "null"] },
        "notes":           { "type": ["string", "null"] }
      }
    },

    "p_flat_rate": {
      "type": "object", "additionalProperties": false, "required": ["rate"],
      "properties": { "rate": { "$ref": "#/$defs/rate" } }
    },
    "p_rate_by_category": {
      "type": "object", "additionalProperties": false, "required": ["categories"],
      "properties": {
        "categories": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "rate"],
            "properties": {
              "key":      { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "label_en": { "type": ["string", "null"] },
              "label_th": { "type": ["string", "null"] },
              "rate":     { "$ref": "#/$defs/rate" }
            }
          }
        }
      }
    },
    "p_rate_with_cap": {
      "type": "object", "additionalProperties": false, "required": ["rate"],
      "properties": {
        "rate":       { "$ref": "#/$defs/rate" },
        "base_floor": { "$ref": "#/$defs/money" },
        "base_cap":   { "$ref": "#/$defs/money" },
        "max_amount": { "$ref": "#/$defs/money" }
      }
    },
    "p_fixed_amount": {
      "type": "object", "additionalProperties": false, "required": ["amount", "per"],
      "properties": {
        "amount":            { "$ref": "#/$defs/money" },
        "per":               { "enum": ["year", "month", "person", "child", "parent", "unit"] },
        "input_field":       { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$", "description": "Employee tax-profile field this allowance reads (count or claimed amount). null = always applies." },
        "input_kind":        { "enum": ["flag", "count", "claimed_amount"] },
        "max_count":         { "type": ["integer", "null"], "minimum": 0 },
        "evidence_required": { "type": "boolean" }
      }
    },
    "p_bracket_table": {
      "type": "object", "additionalProperties": false, "required": ["brackets"],
      "properties": {
        "basis": { "enum": ["progressive", "flat_on_total"] },
        "brackets": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["from", "to", "rate"],
            "properties": {
              "from": { "$ref": "#/$defs/money" },
              "to":   { "anyOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }] },
              "rate": { "$ref": "#/$defs/rate" }
            }
          }
        }
      }
    },
    "p_threshold": {
      "type": "object", "additionalProperties": false, "required": ["min_amount"],
      "properties": {
        "min_amount": { "$ref": "#/$defs/money" },
        "applies_to": { "type": ["string", "null"] }
      }
    },
    "p_formula": {
      "type": "object", "additionalProperties": false, "required": ["expression", "inputs", "output"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "inputs":     { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "output":     { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },

    "test_case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rule", "as_of", "description", "inputs", "expected"],
      "properties": {
        "id":          { "type": "string", "pattern": "^TC-[A-Z0-9_-]+$" },
        "rule":        { "$ref": "#/$defs/rule_code" },
        "company_id":  { "type": ["string", "null"] },
        "as_of":       { "$ref": "#/$defs/date" },
        "description": { "type": "string" },
        "inputs":      { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean"] } },
        "expected":    { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["number", "string", "boolean"] } }
      }
    },

    "approval_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "required_approvals", "approver_roles"],
      "properties": {
        "category":            { "$ref": "#/$defs/category" },
        "required_approvals":  { "type": "integer", "minimum": 1, "maximum": 5 },
        "approver_roles":      { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "escalate_after_days": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "retro_policy": {
      "type": "object", "additionalProperties": false, "required": ["category", "mode"],
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "mode":     { "enum": ["block", "adjust_next_period", "recalculate_reopen"] }
      }
    }
  }
}
